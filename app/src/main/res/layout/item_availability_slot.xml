<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_slot_available"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/slotTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#10261D"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="02:00 PM - 03:00 PM" />

    <TextView
        android:id="@+id/slotStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_slot_status_available"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="#2E6B47"
        android:textSize="12sp"
        tools:text="Available" />

</LinearLayout>
