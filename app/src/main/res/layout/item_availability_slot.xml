<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_slot_booked"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/slotTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="01:00 PM - 03:00 PM" />

    <TextView
        android:id="@+id/slotTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Practice Match" />

    <TextView
        android:id="@+id/slotSubtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        tools:text="Mohit Kanthariya | Box 1" />

    <TextView
        android:id="@+id/slotStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_slot_status_booked"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/brand_primary"
        android:textSize="12sp"
        tools:text="Booked" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/editAvailabilityButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:cropToPadding="true"
            android:background="@drawable/bg_clear_filter_circle"
            android:contentDescription="@string/edit_booking"
            android:padding="10dp"
            android:tint="@color/brand_primary"
            android:src="@drawable/round_mode_edit_24" />

        <ImageButton
            android:id="@+id/deleteAvailabilityButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_clear_filter_circle"
            android:contentDescription="@string/delete_booking"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/brand_primary" />
    </LinearLayout>

</LinearLayout>
